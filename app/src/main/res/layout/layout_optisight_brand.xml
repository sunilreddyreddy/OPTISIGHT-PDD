<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Premium Eye Logo -->
    <ImageView
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/ic_optisight_logo_premium"
        android:contentDescription="@string/optisight_logo_desc" />

    <!-- Brand Name -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/app_name"
        android:textColor="@color/optisight_deep_blue"
        android:textSize="32sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium" />

    <!-- Tagline -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/optisight_tagline"
        android:textColor="@color/optisight_cyan"
        android:textSize="14sp"
        android:letterSpacing="0.15"
        android:textAllCaps="true"
        android:textStyle="bold" />

</LinearLayout>