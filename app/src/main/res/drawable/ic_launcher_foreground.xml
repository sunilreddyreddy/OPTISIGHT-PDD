<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Scale the 100x100 logo to fit in the 108x108 viewport, centered.
         Original logo is 100x100, but safe zone is ~72x72.
         We'll scale it down and center it. -->

    <group
        android:translateX="18"
        android:translateY="18"
        android:scaleX="0.72"
        android:scaleY="0.72">

        <!-- Main Eye Shape (Sclera) -->
        <path
            android:pathData="M10,50 C10,50 28,18 50,18 C72,18 90,50 90,50 C90,50 72,82 50,82 C28,82 10,50 10,50 Z"
            android:strokeWidth="2"
            android:strokeColor="#1A237E"
            android:fillColor="#FFFFFF" />

        <!-- Digital Iris Outer Ring -->
        <path
            android:pathData="M50,50m-24,0a24,24 0,1 1,48 0a24,24 0,1 1,-48 0"
            android:strokeWidth="0.8"
            android:strokeColor="#00E5FF"
            android:strokeAlpha="0.5" />

        <!-- Main Iris with Gradient -->
        <path
            android:pathData="M50,50m-21,0a21,21 0,1 1,42 0a21,21 0,1 1,-42 0">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:centerX="50"
                    android:centerY="50"
                    android:gradientRadius="21"
                    android:type="radial">
                    <item android:color="#00E5FF" android:offset="0.0" />
                    <item android:color="#0D47A1" android:offset="0.7" />
                    <item android:color="#1A237E" android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Scanner Ring -->
        <path
            android:pathData="M50,32 A18,18 0 0,1 68,50 M50,68 A18,18 0 0,1 32,50"
            android:strokeWidth="1"
            android:strokeColor="#FFFFFF"
            android:strokeAlpha="0.4"
            android:strokeLineCap="round" />

        <!-- AI Circuit Patterns -->
        <path
            android:pathData="M50,35 L50,42 M50,58 L50,65 M35,50 L42,50 M58,50 L65,50 M40,40 L44,44 M60,60 L56,56 M40,60 L44,56 M60,40 L56,44"
            android:strokeWidth="0.8"
            android:strokeColor="#FFFFFF"
            android:strokeAlpha="0.6"
            android:strokeLineCap="round" />

        <!-- Central Pupil (AI Chip Core) -->
        <path
            android:fillColor="#0A192F"
            android:pathData="M50,50m-9,0a9,9 0,1 1,18 0a9,9 0,1 1,-18 0" />

        <!-- AI Chip Symbol -->
        <path
            android:fillColor="#00E5FF"
            android:pathData="M47,47h6v6h-6z" />

        <!-- Glint -->
        <path
            android:pathData="M38,38 C42,34 48,34 52,38"
            android:strokeWidth="2"
            android:strokeColor="#FFFFFF"
            android:strokeAlpha="0.3"
            android:strokeLineCap="round" />
    </group>

</vector>